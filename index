<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>VIBE Sales Community</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <style>
        :root { --brand-orange: #FF6B00; --bg-dark: #0A0A0C; --card-bg: #141414; }
        body { 
            background-color: var(--bg-dark); 
            color: #fff; 
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            user-select: none; -webkit-user-select: none;
            padding-bottom: 30px;
        }
        .premium-card { 
            background: var(--card-bg); 
            border: 1px solid #1a1a1c; 
            border-radius: 20px; 
            transition: all 0.2s;
        }
        .premium-card:active { transform: scale(0.98); background: #1c1c1e; }
        .glow-orange { box-shadow: 0 0 15px rgba(255, 107, 0, 0.2); }
        .icon-box { background: rgba(255, 107, 0, 0.1); color: var(--brand-orange); }
    </style>
</head>
<body class="p-4">

    <div class="flex justify-between items-center mb-6 mt-2">
        <div class="flex items-center gap-3">
            <div id="user-avatar" class="w-10 h-10 rounded-full border border-[#FF6B00] flex items-center justify-center overflow-hidden bg-gray-900">
                <span class="text-sm font-bold">V</span>
            </div>
            <div>
                <h1 id="user-name" class="text-sm font-black italic uppercase tracking-wider">Загрузка...</h1>
                <div class="text-[9px] text-[#FF6B00] font-bold uppercase tracking-widest">Community Member</div>
            </div>
        </div>
        <img src="https://i.ibb.co/6R0n7Yx/vibe-logo.png" alt="Logo" class="h-6"> </div>

    <div class="grid grid-cols-2 gap-3 mb-6">
        
        <div class="premium-card p-4 flex flex-col gap-3" onclick="showAlert('Раздел Курсы')">
            <div class="icon-box w-10 h-10 rounded-lg flex items-center justify-center text-xl">🎓</div>
            <div class="text-xs font-bold uppercase">Курсы</div>
        </div>

        <div class="premium-card p-4 flex flex-col gap-3 border-orange-900/30 glow-orange" onclick="showAlert('Топ Бойцов')">
            <div class="icon-box w-10 h-10 rounded-lg flex items-center justify-center text-xl">🥊</div>
            <div class="text-xs font-bold uppercase text-[#FF6B00]">Бойцы</div>
        </div>

        <div class="premium-card p-4 flex flex-col gap-3" onclick="showAlert('Проекты и Вакансии')">
            <div class="icon-box w-10 h-10 rounded-lg flex items-center justify-center text-xl">💼</div>
            <div class="text-xs font-bold uppercase">Проекты</div>
        </div>

        <div class="premium-card p-4 flex flex-col gap-3" onclick="showAlert('Заказ услуг')">
            <div class="icon-box w-10 h-10 rounded-lg flex items-center justify-center text-xl">🛠️</div>
            <div class="text-xs font-bold uppercase">Услуги</div>
        </div>

        <div class="premium-card p-4 flex flex-col gap-3" onclick="showAlert('Книги, Эфиры, Фильмы')">
            <div class="icon-box w-10 h-10 rounded-lg flex items-center justify-center text-xl">📚</div>
            <div class="text-xs font-bold uppercase">Медиатека</div>
        </div>

        <div class="premium-card p-4 flex flex-col gap-3" onclick="showAlert('Настройки профиля')">
            <div class="icon-box w-10 h-10 rounded-lg flex items-center justify-center text-xl">⚙️</div>
            <div class="text-xs font-bold uppercase">Профиль</div>
        </div>

    </div>

    <div class="premium-card p-5 mb-6 bg-gradient-to-br from-[#141414] to-[#1a110a] border-[#FF6B00]/20">
        <h3 class="text-[#FF6B00] text-[10px] font-extrabold uppercase mb-2">Для бизнеса</h3>
        <p class="text-sm font-bold mb-3">Наймите лучших КЗ и Индрайвер уровня</p>
        <button class="w-full py-3 bg-[#FF6B00] rounded-xl text-xs font-black uppercase tracking-tighter" onclick="showAlert('Форма заказа')">
            Оставить заявку
        </button>
    </div>

    <script>
        const tg = window.Telegram.WebApp;
        tg.ready();
        tg.expand();
        tg.setHeaderColor('#0A0A0C');
        tg.setBackgroundColor('#0A0A0C');

        if (tg.initDataUnsafe && tg.initDataUnsafe.user) {
            const user = tg.initDataUnsafe.user;
            document.getElementById('user-name').innerText = user.first_name;
            document.getElementById('user-avatar').innerHTML = `<span class="text-lg font-black text-white">${user.first_name.charAt(0)}</span>`;
        }

        function showAlert(text) { tg.showAlert(text); }
    </script>
</body>
</html>
